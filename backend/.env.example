# Backend only. Copy to backend/.env; never commit .env or credentials.
CUSTOMER_REPOSITORY=dynamodb
AWS_REGION=eu-west-1
DYNAMODB_CUSTOMERS_TABLE=loyalty-customer-dev
# Local development SSO profile only. Omit in AWS workloads using IAM roles.
AWS_PROFILE=loyalty-dev
# For offline development, explicitly set CUSTOMER_REPOSITORY=memory.

# Must match the existing Cognito public frontend client. No client secret.
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=replace-with-existing-user-pool-id
COGNITO_APP_CLIENT_ID=replace-with-existing-web-client-id

# Local-only, opt-in sanitized membership diagnostics. Leave disabled normally.
APP_ENV=development
AUTH_DIAGNOSTICS=false

# Existing private bucket; no bucket is created or changed by the app.
S3_DOCUMENTS_BUCKET=contactly-private-documents-dev
S3_REGION=eu-west-1

# Dedicated device M2M configuration (disabled/unavailable until provisioned).
# Confidential client credentials ONLY clients are separate from the public SPA.
# PRINT_AGENT_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/REPLACE_POOL_ID
# PRINT_AGENT_SCOPE=contactly-print/queue

# Optional server-owned SMS SIMULATION settings per verified business.
# EUR micros: 100000 = EUR 0.10 / segment; 20000000 = EUR 20 monthly cap.
# Illustrative estimates only, NOT a Twilio tariff. No real credentials needed.
# provider accepts ONLY "simulation". A zero monthly limit prevents new queuing.
# SMS_BUSINESS_SETTINGS_JSON={"trumps":{"sender":"TRUMPS PLAZA (simulation)","segment_price_micros":100000,"monthly_limit_micros":20000000,"provider":"simulation"}}

# Optional recovery scopes for the simulation worker after a backend restart.
# Default is empty; verified confirmations/status/history requests also register scope.
# Only already-confirmed jobs are processed; real Twilio delivery is unavailable.
# SMS_WORKER_BUSINESSES=trumps
